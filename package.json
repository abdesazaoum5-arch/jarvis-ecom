{
  "name": "jarvis-ecom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JARVIS ECOM - autonomous e-commerce research and build operating system",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "JARVIS_LOG_DIR=${TMPDIR:-/tmp}/jarvis-test-logs JARVIS_BRIDGE_DIR=${TMPDIR:-/tmp}/jarvis-test-bridge node --test --experimental-strip-types tests/*.test.ts",
    "probe": "node --experimental-strip-types scripts/probe.ts",
    "start": "node --experimental-strip-types apps/command-center/src/server.ts",
    "dev": "node --experimental-strip-types --watch apps/command-center/src/server.ts",
    "prestart": "node scripts/build-web.mjs",
    "predev": "node scripts/build-web.mjs",
    "mission": "node --experimental-strip-types scripts/mission.ts",
    "bridge": "node --experimental-strip-types scripts/bridge.ts",
    "recompute": "node --experimental-strip-types scripts/recompute.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.0"
  }
}
